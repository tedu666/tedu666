.am-animation-slide-top { animation-name: am-slide-top; }

.am-animation-slide-bottom { animation-name: am-slide-bottom; }

.am-animation-slide-left { animation-name: am-slide-left; }

.am-animation-slide-right { animation-name: am-slide-right; }

.am-animation-slide-top-fixed { animation-name: am-slide-top-fixed; }

.am-animation-shake { animation-name: am-shake; }

.am-animation-spin { animation: 2s linear 0s infinite normal none running a=
m-spin; }

.am-animation-left-spring { animation: 0.3s ease-in-out 0s 1 normal none ru=
nning am-left-spring; }

.am-animation-right-spring { animation: 0.3s ease-in-out 0s 1 normal none r=
unning am-right-spring; }

.am-animation-reverse { animation-direction: reverse; }

.am-animation-paused { animation-play-state: paused !important; }

.am-animation-delay-1 { animation-delay: 1s; }

.am-animation-delay-2 { animation-delay: 2s; }

.am-animation-delay-3 { animation-delay: 3s; }

.am-animation-delay-4 { animation-delay: 4s; }

.am-animation-delay-5 { animation-delay: 5s; }

.am-animation-delay-6 { animation-delay: 6s; }

@-webkit-keyframes am-fade {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes am-fade {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@-webkit-keyframes am-scale-up {=20
  0% { opacity: 0; transform: scale(0.2); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes am-scale-up {=20
  0% { opacity: 0; transform: scale(0.2); }
  100% { opacity: 1; transform: scale(1); }
}

@-webkit-keyframes am-scale-down {=20
  0% { opacity: 0; transform: scale(1.8); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes am-scale-down {=20
  0% { opacity: 0; transform: scale(1.8); }
  100% { opacity: 1; transform: scale(1); }
}

@-webkit-keyframes am-slide-top {=20
  0% { opacity: 0; transform: translateY(-100%); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes am-slide-top {=20
  0% { opacity: 0; transform: translateY(-100%); }
  100% { opacity: 1; transform: translateY(0px); }
}

@-webkit-keyframes am-slide-bottom {=20
  0% { opacity: 0; transform: translateY(100%); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes am-slide-bottom {=20
  0% { opacity: 0; transform: translateY(100%); }
  100% { opacity: 1; transform: translateY(0px); }
}

@-webkit-keyframes am-slide-left {=20
  0% { opacity: 0; transform: translateX(-100%); }
  100% { opacity: 1; transform: translateX(0px); }
}

@keyframes am-slide-left {=20
  0% { opacity: 0; transform: translateX(-100%); }
  100% { opacity: 1; transform: translateX(0px); }
}

@-webkit-keyframes am-slide-right {=20
  0% { opacity: 0; transform: translateX(100%); }
  100% { opacity: 1; transform: translateX(0px); }
}

@keyframes am-slide-right {=20
  0% { opacity: 0; transform: translateX(100%); }
  100% { opacity: 1; transform: translateX(0px); }
}

@-webkit-keyframes am-shake {=20
  0%, 100% { transform: translateX(0px); }
  10% { transform: translateX(-9px); }
  20% { transform: translateX(8px); }
  30% { transform: translateX(-7px); }
  40% { transform: translateX(6px); }
  50% { transform: translateX(-5px); }
  60% { transform: translateX(4px); }
  70% { transform: translateX(-3px); }
  80% { transform: translateX(2px); }
  90% { transform: translateX(-1px); }
}

@keyframes am-shake {=20
  0%, 100% { transform: translateX(0px); }
  10% { transform: translateX(-9px); }
  20% { transform: translateX(8px); }
  30% { transform: translateX(-7px); }
  40% { transform: translateX(6px); }
  50% { transform: translateX(-5px); }
  60% { transform: translateX(4px); }
  70% { transform: translateX(-3px); }
  80% { transform: translateX(2px); }
  90% { transform: translateX(-1px); }
}

@-webkit-keyframes am-slide-top-fixed {=20
  0% { opacity: 0; transform: translateY(-10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes am-slide-top-fixed {=20
  0% { opacity: 0; transform: translateY(-10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@-webkit-keyframes am-slide-bottom-fixed {=20
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes am-slide-bottom-fixed {=20
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@-webkit-keyframes am-spin {=20
  0% { transform: rotate(0deg); }
  100% { transform: rotate(359deg); }
}

@keyframes am-spin {=20
  0% { transform: rotate(0deg); }
  100% { transform: rotate(359deg); }
}

@-webkit-keyframes am-right-spring {=20
  0%, 100% { transform: translateX(0px); }
  50% { transform: translateX(-20%); }
}

@keyframes am-right-spring {=20
  0%, 100% { transform: translateX(0px); }
  50% { transform: translateX(-20%); }
}

@-webkit-keyframes am-left-spring {=20
  0%, 100% { transform: translateX(0px); }
  50% { transform: translateX(20%); }
}

@keyframes am-left-spring {=20
  0%, 100% { transform: translateX(0px); }
  50% { transform: translateX(20%); }
}

